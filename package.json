{
  "name": "obsigraph",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p packages/core && tsc -p packages/plugin && tsc -p packages/sidecar && tsc -p packages/cli && tsc -p packages/node-vault && tsc -p packages/graph-ui && tsc -p packages/vscode",
    "build": "npm run build -w @obsigraph/plugin",
    "build:sidecar": "npm run build -w @obsigraph/sidecar",
    "build:cli": "npm run build -w @typedgraph/cli",
    "verify": "npm run -s typecheck && vitest run --reporter=dot && lat check",
    "version:bump": "node scripts/version-bump.mjs",
    "site:build": "node site/build.mjs",
    "site:ontologies": "node scripts/build-ontologies.mjs",
    "site:articles": "node site/build-articles.mjs",
    "example:install": "node scripts/install-example.mjs",
    "build:vscode": "npm run build -w typegraph-vscode",
    "package:vscode": "npm run package -w typegraph-vscode",
    "release:vscode": "node scripts/release-vscode.mjs",
    "check:install": "node scripts/check-plugin-install.mjs"
  },
  "devDependencies": {
    "@asciidoctor/core": "^4.1.1",
    "@types/n3": "^1.26.4",
    "@types/node": "^26.6.4",
    "ajv": "^8.20.0",
    "marked": "^16.4.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "version": "0.21.0",
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
