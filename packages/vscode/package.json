{
  "name": "typegraph-vscode",
  "displayName": "TypeGraph",
  "description": "Typed backlinks and a graph view for your markdown and code, with no Obsidian required.",
  "version": "0.13.0",
  "private": true,
  "publisher": "pavlyshyn",
  "license": "MIT",
  "type": "module",
  "icon": "media/icon.png",
  "repository": { "type": "git", "url": "https://github.com/Volland/typedgraph" },
  "categories": ["Visualization", "Other"],
  "keywords": ["markdown", "backlinks", "graph", "lat.md", "knowledge graph", "typed links"],
  "engines": { "vscode": "^1.90.0" },
  "main": "dist/extension.cjs",
  "activationEvents": ["workspaceContains:**/*.md", "workspaceContains:**/*.adoc", "onStartupFinished"],
  "contributes": {
    "configuration": {
      "title": "TypeGraph",
      "properties": {
        "typegraph.roots": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["."],
          "markdownDescription": "Folders, relative to the workspace folder, whose markdown and annotated source files form the graph. Dot folders and `node_modules` are always skipped."
        },
        "typegraph.ignore": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["node_modules"],
          "markdownDescription": "Folder names skipped at any depth, in addition to dot folders."
        },
        "typegraph.asciidoc": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Index `.adoc` files as notes beside markdown: properties from a leading `////` block and `:tg-*:` attributes, edges from `// @tg:` comments."
        },
        "typegraph.schemaFolder": {
          "type": "string",
          "default": "Types/",
          "markdownDescription": "Folder, relative to the workspace folder, whose notes declare types (TGS). Used by the **New Typed Note** commands."
        },
        "typegraph.fullGraphLimit": {
          "type": "number",
          "default": 2000,
          "minimum": 10,
          "markdownDescription": "Most nodes the **Whole project** graph draws. Over the limit it keeps the most connected nodes and says how many it left out."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [{ "id": "typegraph", "title": "TypeGraph", "icon": "media/activity.svg" }]
    },
    "views": {
      "typegraph": [
        { "id": "typegraph.backlinks", "name": "Backlinks" }
      ]
    },
    "viewsWelcome": [
      {
        "view": "typegraph.backlinks",
        "contents": "Open a markdown or source file to see its typed backlinks.\n[Set up TypeGraph](command:typegraph.setup)",
        "when": "typegraph.needsSetup"
      }
    ],
    "commands": [
      { "command": "typegraph.openGraph", "title": "TypeGraph: Open Graph", "icon": "$(graph)" },
      { "command": "typegraph.openFullGraph", "title": "TypeGraph: Open Full Graph", "icon": "$(type-hierarchy)" },
      { "command": "typegraph.exportGraphHtml", "title": "TypeGraph: Export Graph as HTML", "icon": "$(file-code)" },
      { "command": "typegraph.exportGraphPdf", "title": "TypeGraph: Export Graph as PDF", "icon": "$(file-pdf)" },
      { "command": "typegraph.setup", "title": "TypeGraph: Set Up TypeGraph" },
      { "command": "typegraph.refresh", "title": "TypeGraph: Refresh Index", "icon": "$(refresh)" },
      { "command": "typegraph.newNote", "title": "TypeGraph: New Typed Note", "icon": "$(new-file)" },
      { "command": "typegraph.newChildNote", "title": "TypeGraph: New Child Note (Luhmann id)" },
      { "command": "typegraph.newSiblingNote", "title": "TypeGraph: New Sibling Note (Luhmann id)" }
    ],
    "menus": {
      "view/title": [
        { "command": "typegraph.openGraph", "when": "view == typegraph.backlinks", "group": "navigation@1" },
        { "command": "typegraph.openFullGraph", "when": "view == typegraph.backlinks", "group": "navigation@2" },
        { "command": "typegraph.exportGraphHtml", "when": "view == typegraph.backlinks", "group": "navigation@3" },
        { "command": "typegraph.exportGraphPdf", "when": "view == typegraph.backlinks", "group": "navigation@4" },
        { "command": "typegraph.newNote", "when": "view == typegraph.backlinks", "group": "navigation@5" },
        { "command": "typegraph.refresh", "when": "view == typegraph.backlinks", "group": "navigation@6" }
      ],
      "explorer/context": [
        { "command": "typegraph.newNote", "when": "explorerResourceIsFolder", "group": "2_workspace@9" }
      ]
    }
  },
  "dependencies": {
    "@obsigraph/core": "*",
    "@obsigraph/graph-ui": "*",
    "@obsigraph/node-vault": "*"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.28.2",
    "ovsx": "^0.10.5"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "package": "node esbuild.config.mjs && vsce package --no-dependencies --allow-missing-repository -o typegraph.vsix"
  }
}
